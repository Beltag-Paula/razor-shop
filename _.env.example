# Public address of the site (must be https:// in production)
BASE_URL=https://your-domain.com

# First start only: creates the owner account. Remove ADMIN_PASSWORD afterwards (12+ characters).
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# 64 hex characters. Generate with: openssl rand -hex 32   (keep it; losing it loses encrypted notification settings)
SERVER_KEY=

# Time zone and phone defaults
TZ=Europe/Bucharest
DEFAULT_COUNTRY_CODE=40

# Local testing over plain http://localhost:3000 ONLY (production cookies require HTTPS):
# NODE_ENV=development

# Email (optional; without it messages are printed in the container log)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM="ANM Beauty Center <you@gmail.com>"
# CONTACT_TO=you@gmail.com
